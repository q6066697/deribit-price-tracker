# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deribit
# "db" is the service name in docker-compose; use "localhost" for a local run
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery broker; "redis" is the service name in docker-compose
REDIS_URL=redis://redis:6379/0

# Deribit
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_TIMEOUT_SECONDS=10
PRICE_FETCH_INTERVAL_SECONDS=60
